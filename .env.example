# Copy this file to .env and fill in your values. Never commit .env.

# Required: your Discord bot token
DISCORD_TOKEN=

# Your main/support server. Owner-only commands (/create-embed, /maintenance) are registered there.
# Leave 0 to skip those commands.
DISCORD_SERVER=0
# Channel for /maintenance status messages (0 = none)
DISCORD_STATUS_CHANNEL=0
# Your Discord user id, allowed to use /maintenance
BOT_OWNER=0
# Optional: guild that gets all global commands synced instantly (for testing), 0 = off
DEV_GUILD_ID=0
# Initial maintenance state on startup
MAINTENANCE_MODE=false
DISCORD_INVITE=https://discord.gg/mpgbu3M5Yy

# Storage: database lives in DATA_DIR unless DATABASE_PATH is set
DATA_DIR=data
# DATABASE_PATH=data/ltl_database.db

# Logging: always to stdout; set LOG_TO_FILE=true for daily rotating files in LOG_DIR
LOG_LEVEL=INFO
LOG_TO_FILE=false
# LOG_DIR=data/logs
LOG_RETENTION_DAYS=8
TIMEZONE=Europe/Berlin

# Optional heartbeat server (only used when heartbeat.py exists)
HEALTH_CHECK_PORT=8000
